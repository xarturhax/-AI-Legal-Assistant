  => nrel_themis_query_marker: [не платит алименты];
  => nrel_themis_query_marker: [подать на алименты];
  => nrel_themis_query_marker: [алименты на двух детей];
  => nrel_themis_query_marker: [алименты на одного ребёнка];
  => nrel_related_articles: by_act_hk9900278_article_91;
  => nrel_related_articles: by_act_hk9900278_article_92;
  => nrel_themis_case_check: [Уточните возраст и число детей, есть ли соглашение, брачный договор или решение суда, а также известны ли доходы и другие обстоятельства, влияющие на размер алиментов.];
  <- rrel_key_sc_element: ... (*
    <- definition;;
