belarus_legal_term -> concept_eviction_after_residential_lease_belarus;;
belarus_legal_term -> concept_return_defective_goods_belarus;;

themis_situation_topic -> concept_eviction_after_residential_lease_belarus;;
themis_situation_topic -> concept_return_defective_goods_belarus;;

belarus_legal_act -> by_act_h10200090;;
belarus_legal_article -> by_act_h10200090_article_20;;

concept_eviction_after_residential_lease_belarus
  => nrel_main_idtf: [выселение при найме жилья] (* <- lang_ru;; *);
  => nrel_themis_query_marker: [выселить];
  => nrel_themis_query_marker: [выселяют];
  => nrel_themis_query_marker: [выселение];
  => nrel_themis_query_marker: [расторжение договора найма];
  => nrel_related_articles: by_act_hk1200428_article_61;
  => nrel_related_articles: by_act_hk1200428_article_62;
  => nrel_related_articles: by_act_hk1200428_article_64;
  => nrel_themis_case_check: [Проверьте дату окончания договора, условия его досрочного расторжения и какое основание наймодатель указал письменно. Длительность проживания сама по себе не показывает, истёк ли срок договора.];
  <- rrel_key_sc_element: ... (*
    <- definition;;
    <= nrel_sc_text_translation: ... (*
      -> rrel_example: [Нормы о прекращении и досрочном расторжении договора найма жилого помещения и о судебном выселении после прекращения договора в Беларуси.] (* <- lang_ru;; *);;
    *);;
  *);;

by_act_hk1200428_article_61
  => nrel_themis_source_citation: [Жилищный кодекс Республики Беларусь, статья 61, пункт 1.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk1200428];
  => nrel_themis_practical_summary: [Если договор найма заключён на определённый срок, по общему правилу истечение этого срока прекращает договор.];;

by_act_hk1200428_article_62
  => nrel_themis_source_citation: [Жилищный кодекс Республики Беларусь, статья 62, пункты 3 и 5.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk1200428];
  => nrel_themis_practical_summary: [Существенное нарушение условий договора может быть основанием для досрочного расторжения. При расторжении по инициативе наймодателя он направляет за месяц письменное предупреждение с мотивами. После истечения месяца он может заявить требование в суд, если наниматель отказался расторгнуть договор или не ответил.];;

by_act_hk1200428_article_64
  => nrel_themis_source_citation: [Жилищный кодекс Республики Беларусь, статья 64, пункты 1 и 2.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk1200428];
  => nrel_themis_practical_summary: [После прекращения или расторжения договора нужно освободить помещение в установленный срок. Если наниматель и проживающие с ним граждане не освободили его, применяется судебный порядок выселения.];;

concept_return_defective_goods_belarus
  => nrel_main_idtf: [возврат товара ненадлежащего качества] (* <- lang_ru;; *);
  => nrel_themis_query_marker: [товар ненадлежащего качества];
  => nrel_themis_query_marker: [неисправный товар];
  => nrel_themis_query_marker: [некачественный товар];
  => nrel_themis_query_marker: [бракованный товар];
  => nrel_themis_query_marker: [продавец отказывается возвращать деньги];
  => nrel_themis_query_marker: [продавец отказывается вернуть деньги];
  => nrel_related_articles: by_act_h10200090_article_20;
  => nrel_themis_case_check: [Для оценки требования уточните, где и у кого куплен товар, дату передачи и дату обращения к продавцу, причину отказа и результат проверки качества, если она уже была. Дата обнаружения неисправности сама по себе не устанавливает дату предъявления требования.];
  <- rrel_key_sc_element: ... (*
    <- definition;;
    <= nrel_sc_text_translation: ... (*
      -> rrel_example: [Возврат денег за товар с недостатком по договору розничной купли-продажи в Беларуси, включая правила для технически сложных товаров и проверку качества при отказе продавца.] (* <- lang_ru;; *);;
    *);;
  *);;

by_act_h10200090
  => nrel_main_idtf: [Закон Республики Беларусь от 9 января 2002 г. № 90-З «О защите прав потребителей»] (* <- lang_ru;; *);
  => nrel_themis_source_url: [https://pravo.by/document/?guid=3871&p0=H10200090];
  => nrel_article: by_act_h10200090_article_20;;

by_act_h10200090_article_20
  => nrel_main_idtf: [Статья 20. Права потребителя в случае реализации товара ненадлежащего качества] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Закон Республики Беларусь от 9 января 2002 г. № 90-З «О защите прав потребителей», статья 20, пункты 1, 3, 4, 7 и 11.];
  => nrel_themis_source_url: [https://pravo.by/document/?guid=3871&p0=H10200090];
  => nrel_themis_practical_summary: [При розничной покупке в Беларуси для личных нужд, если продавец не оговорил недостаток товара, потребитель может предъявить продавцу требование о расторжении договора и возврате денег. Для технически сложного или дорогостоящего товара это требование можно предъявить в течение 30 дней после передачи. Позже нужны специальные основания, например существенный недостаток или нарушение установленного срока бесплатного ремонта. Продавец обязан принять некачественный товар и при необходимости проверить качество. При споре о наличии или причине недостатка применяется экспертиза.];
  <- rrel_key_sc_element: ... (*
    <- definition;;
    <= nrel_sc_text_translation: ... (*
      -> rrel_example: [Справочное изложение отдельных положений статьи 20. При продаже товара с неоговорённым недостатком закон предусматривает несколько требований к продавцу, в том числе расторжение розничной покупки с возвратом денег. Для технически сложных и дорогостоящих товаров действует специальный срок предъявления такого требования и условия его предъявления после окончания срока. Продавец принимает некачественный товар и при необходимости проверяет качество. Если возник спор о наличии или причине недостатка, закон предусматривает экспертизу. Полный текст доступен на Национальном правовом интернет-портале.] (* <- lang_ru;; *);;
    *);;
  *);;
