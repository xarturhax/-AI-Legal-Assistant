  => nrel_main_idtf: [обмен или возврат товара надлежащего качества] (* <- lang_ru;; *);
  => nrel_themis_query_marker: [не подошёл размер];
  => nrel_themis_query_marker: [не подошла по размеру];
  => nrel_themis_query_marker: [вернуть товар без брака];
  => nrel_themis_query_marker: [товар надлежащего качества];
  => nrel_themis_query_marker: [вернуть исправный товар];
  => nrel_related_articles: by_act_h10200090_article_28;
  => nrel_themis_case_check: [Сверьте категорию товара с перечнем исключений, дату получения, был ли товар в употреблении, сохранились ли его свойства и упаковка, если товар был в ней продан.];
  <- rrel_key_sc_element: ... (*
