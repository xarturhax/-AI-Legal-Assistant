belarus_legal_article -> by_act_h10200090_article_22;;
by_act_h10200090 => nrel_article: by_act_h10200090_article_22;;

by_act_h10200090_article_22
  => nrel_main_idtf: [Статья 22. Безвозмездное устранение недостатков товара] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Закон Республики Беларусь от 9 января 2002 г. № 90-З «О защите прав потребителей», статья 22, пункты 1 и 5.];
  => nrel_themis_source_url: [https://pravo.by/document/?guid=3871&p0=H10200090];
  => nrel_themis_practical_summary: [Недостатки товара при предъявлении требования о безвозмездном устранении обычно должны устранить незамедлительно. Если это невозможно, срок ограничен 14 днями со дня предъявления требования. Письменное соглашение с потребителем позволяет продлить срок максимум до 30 дней. При бесплатном ремонте ремонтная организация оформляет запись в гарантийном талоне либо отдельный документ при его отсутствии.];;

belarus_legal_article -> by_act_h10200090_article_28;;
by_act_h10200090 => nrel_article: by_act_h10200090_article_28;;

by_act_h10200090_article_28
  => nrel_main_idtf: [Статья 28. Право потребителя на обмен и возврат товара надлежащего качества] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Закон Республики Беларусь от 9 января 2002 г. № 90-З «О защите прав потребителей», статья 28, пункты 1–3.];
  => nrel_themis_source_url: [https://pravo.by/document/?guid=3871&p0=H10200090];
  => nrel_themis_practical_summary: [Непродовольственный товар надлежащего качества по общему правилу можно вернуть или обменять в течение 14 дней с передачи, если продавец не объявил более длительный срок. Товар должен быть неиспользованным, с сохранёнными потребительскими свойствами, а покупка у этого продавца должна подтверждаться. Если товар продан в потребительской упаковке, вернуть нужно и её. Для отдельных категорий возврат и обмен исключены.];;
