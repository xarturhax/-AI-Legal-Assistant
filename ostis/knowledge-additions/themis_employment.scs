belarus_legal_article -> by_act_hk9900296_article_40;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_40;;

by_act_hk9900296_article_40
  => nrel_main_idtf: [Статья 40. Расторжение трудового договора, заключённого на неопределённый срок, по желанию работника] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 40, части первая и вторая.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [При бессрочном трудовом договоре работник может по общему правилу уйти по собственному желанию, письменно предупредив нанимателя за один месяц. По соглашению сторон или в случаях, указанных в коллективном договоре, договор может закончиться раньше.];;

belarus_legal_article -> by_act_hk9900296_article_41;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_41;;

by_act_hk9900296_article_41
  => nrel_main_idtf: [Статья 41. Расторжение срочного трудового договора по требованию работника] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 41, часть первая.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [Для срочного трудового договора предусмотрено досрочное расторжение по требованию работника при уважительных причинах, препятствующих работе, либо при нарушении нанимателем трудового законодательства, коллективного или трудового договора.];;

belarus_legal_article -> by_act_hk9900296_article_77;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_77;;

by_act_hk9900296_article_77
  => nrel_main_idtf: [Статья 77. Сроки окончательного расчёта при увольнении] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 77, части первая и вторая.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [Причитающиеся при увольнении выплаты по общему правилу производятся не позднее дня увольнения. Для выплат, рассчитываемых по итогам отчётного периода, есть исключение. Если работник в день увольнения не работал или договор расторгнут в день окончания предварительного испытания, соответствующие суммы выплачиваются не позднее следующего дня после требования о расчёте. При споре о размере в установленный срок выплачивают неоспариваемую сумму.];;

belarus_legal_article -> by_act_hk9900296_article_155;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_155;;

by_act_hk9900296_article_155
  => nrel_main_idtf: [Статья 155. Продолжительность основного отпуска] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 155, часть первая.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [Минимальная продолжительность основного отпуска по общему правилу составляет 24 календарных дня. Законодательными актами могут устанавливаться иные правила.];;

belarus_legal_article -> by_act_hk9900296_article_174;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_174;;

by_act_hk9900296_article_174
  => nrel_main_idtf: [Статья 174. Разделение трудового отпуска на части. Отзыв из отпуска] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 174, часть первая.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [По договорённости работника и нанимателя трудовой отпуск может быть разделён на две части, если коллективный договор, соглашение или иной локальный акт не предусматривают другой порядок. Одна часть должна составлять не менее 14 календарных дней.];;

belarus_legal_article -> by_act_hk9900296_article_179;;
by_act_hk9900296 => nrel_article: by_act_hk9900296_article_179;;

by_act_hk9900296_article_179
  => nrel_main_idtf: [Статья 179. Денежная компенсация за неиспользованный трудовой отпуск при увольнении] (* <- lang_ru;; *);
  => nrel_themis_source_citation: [Трудовой кодекс Республики Беларусь, статья 179, части первая и третья.];
  => nrel_themis_source_url: [https://etalonline.by/document/?regnum=hk9900296];
  => nrel_themis_practical_summary: [При увольнении работнику выплачивают компенсацию за неиспользованный трудовой отпуск, в том числе за его неиспользованную часть. Если рабочий год отработан не полностью, компенсацию рассчитывают пропорционально отработанному времени.];;
