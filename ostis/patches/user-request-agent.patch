+void CollectMatches(
+    ScMemoryContext & context,
+    ScTemplate const & pattern,
+    char const * alias,
+    ScAddrSet & matches)
+{
+  ScTemplateSearchResult results;
+  context.SearchByTemplate(pattern, results);
+  for (size_t index = 0; index < results.Size(); ++index)
+  {
+    ScTemplateResultItem row;
+    results.Get(index, row);
+    ScAddr match;
+    row.Get(alias, match);
+    if (match.IsValid())
+      matches.insert(match);
+  }
+}
+
+void CollectRelated(
+    ScMemoryContext & context,
+    ScAddr const & term,
+    ScAddr const & relation,
+    bool reverse,
+    ScAddrSet & result)
+{
+  ScTemplate pattern;
+  if (reverse)
+    pattern.Quintuple(
+        ScType::VarNode >> "_related", ScType::VarCommonArc, term,
+        ScType::VarPermPosArc, relation);
+  else
+    pattern.Quintuple(
+        term, ScType::VarCommonArc, ScType::VarNode >> "_related",
+        ScType::VarPermPosArc, relation);
+  CollectMatches(context, pattern, "_related", result);
+}
+
+void CollectDefinitions(ScMemoryContext & context, ScAddr const & term, ScAddrSet & result)
+{
+  ScTemplate pattern;
+  pattern.Quintuple(
+      ScType::VarNode >> "_structure", ScType::VarPermPosArc, term,
+      ScType::VarPermPosArc, UserRequestKeynodes::rrel_key_sc_element);
+  pattern.Quintuple(
+      ScType::VarNode >> "_translation", ScType::VarCommonArc, "_structure",
+      ScType::VarPermPosArc, UserRequestKeynodes::nrel_sc_text_translation);
+  pattern.Quintuple(
+      "_translation", ScType::VarPermPosArc, ScType::VarNodeLink >> "_definition",
+      ScType::VarPermPosArc, UserRequestKeynodes::rrel_example);
+  pattern.Triple(UserRequestKeynodes::lang_ru, ScType::VarPermPosArc, "_definition");
+  CollectMatches(context, pattern, "_definition", result);
+}
